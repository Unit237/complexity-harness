{
  "schema_version": "complexity-harness-policy-v1",
  "measurements": {
    "cyclomatic": {
      "meaning": "local-control-flow-path-count",
      "may_imply": ["investigation-candidate"],
      "must_not_imply": [
        "universal-maintainability-score",
        "architectural-defect",
        "automatic-refactor-authorization"
      ],
      "required_evidence": ["path", "symbol", "branch-kind", "branch-line"]
    }
  },
  "architectural_memory": {
    "role": "durable-semantic-context",
    "required_fields": [
      "id",
      "concept",
      "status",
      "summary",
      "evidence",
      "decision",
      "next_trigger"
    ],
    "separate_from_numeric_findings": true
  },
  "workspace_scans": {
    "canonical_inventory_required": true,
    "exclude_aliases_and_generated_paths": true,
    "preserve_repository_identity": true,
    "aggregate_only_after_repository_scans": true
  },
  "refactor_jobs": {
    "executor_neutral": true,
    "required_scope_controls": {
      "max_changed_files": 5,
      "scope_expansion": "stop-and-request-review"
    },
    "required_verification": {
      "before_after_snapshot": true,
      "behavior_characterization_required": true
    },
    "missing_verification_behavior": "block-execution",
    "required_agent_steps": [
      "read-agent-instructions-and-architectural-memory",
      "characterize-behavior-before-editing",
      "inspect-analogous-hotspots-and-invariants",
      "remain-inside-explicit-path-scope",
      "run-required-checks-and-after-snapshot",
      "return-draft-only"
    ],
    "required_policy": {
      "approval": "human-required",
      "output": "draft-change-or-draft-pr",
      "automatic_merge": false,
      "production_deploy": false,
      "secrets_access": false,
      "destructive_migrations": false
    }
  }
}
