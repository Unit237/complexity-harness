{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightreach.io/contracts/refactor-job-v1.schema.json",
  "title": "Bounded refactor job v1",
  "type": "object",
  "required": [
    "schema_version",
    "finding_id",
    "objective",
    "source",
    "evidence",
    "architectural_memory_ids",
    "architectural_memory",
    "registered_invariant_ids",
    "registered_invariants",
    "scope",
    "verification",
    "policy",
    "readiness",
    "agent_instructions",
    "stop_conditions",
    "agent_prompt"
  ],
  "properties": {
    "schema_version": {"const": "refactor-job-v1"},
    "finding_id": {"type": "string", "minLength": 1},
    "executor": {"type": ["string", "null"]},
    "objective": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "evidence": {"type": "object"},
    "architectural_memory_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "architectural_memory": {"type": "array"},
    "registered_invariant_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "registered_invariants": {"type": "array"},
    "scope": {
      "type": "object",
      "required": ["allowed_paths", "max_changed_files", "scope_expansion"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "max_changed_files": {"const": 5},
        "scope_expansion": {"const": "stop-and-request-review"}
      }
    },
    "verification": {
      "type": "object",
      "required": ["required_checks", "before_after_snapshot", "behavior_characterization_required"],
      "properties": {
        "required_checks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "before_after_snapshot": {"const": true},
        "behavior_characterization_required": {"const": true}
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "approval",
        "output",
        "automatic_merge",
        "production_deploy",
        "secrets_access",
        "destructive_migrations"
      ],
      "properties": {
        "approval": {"const": "human-required"},
        "output": {"const": "draft-change-or-draft-pr"},
        "automatic_merge": {"const": false},
        "production_deploy": {"const": false},
        "secrets_access": {"const": false},
        "destructive_migrations": {"const": false}
      }
    },
    "readiness": {
      "type": "object",
      "required": ["status", "blockers"],
      "properties": {
        "status": {"enum": ["ready", "blocked"]},
        "blockers": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "ready"}}},
        "then": {"properties": {"blockers": {"maxItems": 0}}},
        "else": {"properties": {"blockers": {"minItems": 1}}}
      }]
    },
    "agent_instructions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "agent_prompt": {"type": "string", "minLength": 1}
  }
}
